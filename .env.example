# ---------------------------------------------------------------------------
# PEKİYİ Mobilya internal system — environment variables
# Copy this file to .env and fill in real values. .env is git-ignored.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=pekiyi
POSTGRES_USER=pekiyi
POSTGRES_PASSWORD=change-me-strong-password
# Port exposed on the host (useful for local DB inspection tools)
POSTGRES_PORT=5432

# Full connection string the app (Drizzle) uses to talk to Postgres.
DATABASE_URL=postgres://pekiyi:change-me-strong-password@localhost:5432/pekiyi

# --- Auth (Better Auth) -----------------------------------------------------
# Random secret used to sign sessions — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-random-secret
BETTER_AUTH_URL=http://localhost:3000

# First admin account, created by `pnpm db:seed`. Public sign-up is disabled;
# every other user is created by an admin from inside the app.
SEED_ADMIN_EMAIL=admin@pekiyi.local
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_NAME=Admin

# Optional — set to "true" to also seed two test accounts (one per non-admin
# role) when running `pnpm db:seed`. Useful for local development only.
SEED_TEST_USERS=false
SEED_EXPORT_EMAIL=export@pekiyi.local
SEED_EXPORT_PASSWORD=change-me-strong-password
SEED_EXPORT_NAME=Export Test User
SEED_PRODUCTION_EMAIL=production@pekiyi.local
SEED_PRODUCTION_PASSWORD=change-me-strong-password
SEED_PRODUCTION_NAME=Production Test User

# Optional — set to "true" to also seed the sample customers and the 4 real
# sample orders from web/db/seed-data/pekiyi-seed-data.json. Development only.
SEED_FIXTURES=false

# --- Next.js (web) ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local file uploads (Phase 7+) — directory the storage helper writes to.
UPLOAD_DIR=./uploads
