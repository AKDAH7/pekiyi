# ---------------------------------------------------------------------------
# PEKİYİ Mobilya internal system — environment variables
# Copy this file to .env and fill in real values. .env is git-ignored.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=pekiyi
POSTGRES_USER=pekiyi
POSTGRES_PASSWORD=change-me-strong-password
# Port exposed on the host (useful for local DB inspection tools)
POSTGRES_PORT=5432

# Full connection string the app (Drizzle) uses to talk to Postgres.
DATABASE_URL=postgres://pekiyi:change-me-strong-password@localhost:5432/pekiyi

# Separate database for automated tests, in the same Postgres container. The
# e2e global setup creates it if missing, wipes it, migrates and seeds it on
# every `pnpm test:e2e`; DB-backed unit tests use it too. Tests never touch
# DATABASE_URL. Must point to a different database whose name ends in "_test".
DATABASE_URL_TEST=postgres://pekiyi:change-me-strong-password@localhost:5432/pekiyi_test

# --- Auth (Better Auth) -----------------------------------------------------
# Random secret used to sign sessions — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-random-secret
BETTER_AUTH_URL=http://localhost:3000

# First admin account, created by `pnpm db:seed`. Public sign-up is disabled;
# every other user is created by an admin from inside the app.
SEED_ADMIN_EMAIL=admin@pekiyi.local
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_NAME=Admin

# Optional — set to "true" to also seed two test accounts (one per non-admin
# role) when running `pnpm db:seed`. Useful for local development only.
SEED_TEST_USERS=false
SEED_EXPORT_EMAIL=export@pekiyi.local
SEED_EXPORT_PASSWORD=change-me-strong-password
SEED_EXPORT_NAME=Export Test User
SEED_PRODUCTION_EMAIL=production@pekiyi.local
SEED_PRODUCTION_PASSWORD=change-me-strong-password
SEED_PRODUCTION_NAME=Production Test User

# Optional — set to "true" to also seed the sample customers and the 4 real
# sample orders from web/db/seed-data/pekiyi-seed-data.json. Development only.
SEED_FIXTURES=false

# --- Next.js (web) ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Uploaded images (model photos, company logo) — directory web/lib/storage writes
# to. Relative paths resolve from web/ (the Next.js working directory); the
# folder is git-ignored. Files are served only through the authenticated
# /api/files route, never from /public.
UPLOAD_DIR=./uploads

# Documents (proforma PDF/Excel, lib/documents) — rendered by headless Chromium.
# Empty = the locally installed Google Chrome. On the VPS: the path of a
# Playwright-installed Chromium (e.g. `npx playwright install chromium`, then
# ~/.cache/ms-playwright/chromium-*/chrome-linux/chrome). Rendered issued files
# are stored under UPLOAD_DIR/documents and reused.
CHROMIUM_PATH=
