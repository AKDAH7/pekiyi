{
  "name": "pekiyi",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:studio": "pnpm --filter web db:studio",
    "db:seed": "pnpm --filter web db:seed",
    "db:seed:check": "pnpm --filter web db:seed:check",
    "files:cleanup": "pnpm --filter web files:cleanup",
    "dev": "pnpm --filter web dev",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "test:e2e": "pnpm --filter web test:e2e",
    "check": "pnpm --filter web check"
  }
}
